# Bazel configuration for disruptor-queue

# C++ standard version
build --cxxopt=-std=c++20
build --host_cxxopt=-std=c++20

build --config=opt
build:opt --compilation_mode=opt
build:opt --copt=-O3
build:opt --copt=-flto
build:opt --copt=-fomit-frame-pointer
build:opt --linkopt=-O3
build:opt --linkopt=-flto
build:opt --linkopt=-fomit-frame-pointer

build:debug --compilation_mode=dbg
build:debug --copt=-O0
build:debug --copt=-fno-lto
build:debug --copt=-fno-omit-frame-pointer
build:debug --copt=-g
build:debug --linkopt=-O0
build:debug --linkopt=-fno-lto
build:debug --linkopt=-fno-omit-frame-pointer
build:debug --strip=never

# Warnings
build --copt=-Wall
build --copt=-Wextra
build --copt=-Wpedantic

# Test output
test --test_output=errors

# Colorful output
common --color=yes

# Enable build cache
build --disk_cache=~/.cache/bazel-disk-cache

# Try to import user-specific settings
try-import %workspace%/.bazelrc.user
